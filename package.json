{
  "name": "@zebrajaeger/opencode-scheduler",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Bounded same-session prompt timers for OpenCode agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.de.md",
    "LICENSE",
    "docs/*.md",
    "docs/banner.png",
    "docs/upstream/persist-events-proposal.md",
    "docs/upstream/opencode-v2.4.2-persist-events.patch"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/zebrajaeger/opencode-scheduler.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/real-host.test.ts test/orchestration-real-host.test.ts test/sqlite-runtime.test.ts",
    "release:check": "node scripts/release.mjs pack",
    "release": "npm run release:check && npm publish .release-artifacts/package.tgz --access public --ignore-scripts --registry=https://registry.npmjs.org",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@opencode/schema": "2.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "opencode-plugin-241": "npm:@opencode/plugin@2.4.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
