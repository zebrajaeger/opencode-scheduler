--- /dev/null
+++ b/packages/cli/test/persist-events.test.ts
@@ -0,0 +1,42 @@
+import { expect, test } from "bun:test"
+import { NodeServices } from "@effect/platform-node"
+import { Effect } from "effect"
+import { CliOutput, Command } from "effect/cli"
+import { Commands } from "../src/commands/commands"
+
+test.each([
+  { args: [], persist: false },
+  { args: ["--experimental-persist-events"], persist: true },
+  { args: ["--service", "--experimental-persist-events"], persist: true },
+  { args: ["--stdio", "--experimental-persist-events"], persist: true },
+])("serve native payload retention is explicit: $args", async ({ args, persist }) => {
+  const received: boolean[] = []
+  const command = Commands.commands.serve.spec.pipe(
+    Command.withHandler((input) => Effect.sync(() => void received.push(input.persistEvents))),
+  )
+  await Effect.runPromise(Command.runWith(command, { version: "test" })(args).pipe(Effect.provide(NodeServices.layer)))
+  expect(received).toEqual([persist])
+})
+
+test("serve help identifies experimental storage cost", async () => {
+  const pages: string[] = []
+  const formatter = CliOutput.defaultFormatter({ colors: false })
+  const command = Commands.commands.serve.spec.pipe(Command.withHandler(() => Effect.void))
+  await Effect.runPromise(
+    Command.runWith(command, { version: "test" })(["--help"]).pipe(
+      Effect.provide(
+        CliOutput.layer({
+          ...formatter,
+          formatHelpDoc: (doc) => {
+            const page = formatter.formatHelpDoc(doc)
+            pages.push(page)
+            return page
+          },
+        }),
+      ),
+      Effect.provide(NodeServices.layer),
+    ),
+  )
+  expect(pages.join("\n")).toContain("--experimental-persist-events")
+  expect(pages.join("\n")).toContain("increases database storage")
+})
